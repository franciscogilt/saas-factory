# ───────────── Motor de IA ─────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelos por agente (opcional)
MODEL_STRATEGY=claude-opus-5-5     # ideador, producto, arquitecto
MODEL_ENGINEER=claude-sonnet-5-5   # programador y QA

# ───────────── Límites de seguridad ─────────────
MAX_TOKENS_PER_PROJECT=8000000   # se detiene si un SaaS supera este consumo
MAX_QA_ROUNDS=8                  # intentos de arreglar build/typecheck
CONCURRENCY=2                    # SaaS construidos en paralelo en modo batch
WORKSPACE_DIR=./projects         # dónde se generan los proyectos

# ───────────── GitHub ─────────────
GITHUB_TOKEN=ghp_...             # permisos: repo
GITHUB_OWNER=tu-usuario          # usuario u organización
GITHUB_PRIVATE=true

# ───────────── Vercel ─────────────
VERCEL_TOKEN=...
VERCEL_TEAM_ID=                  # opcional
# Requisito: instala la app de GitHub de Vercel en tu cuenta de GitHub.

# ───────────── Supabase (Management API) ─────────────
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_ORG_ID=...
SUPABASE_REGION=us-east-1

# ───────────── Stripe ─────────────
STRIPE_SECRET_KEY=sk_test_...    # empieza en modo test
